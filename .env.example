# Server/CLI only. Add your AI Studio key and exact model ID to .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=
# Supported by the selected gemini-3.5-flash-lite; low (default), medium, or high.
# GEMINI_THINKING_LEVEL=low

# Shared limits; max output includes the model's thinking allowance.
# INCIDENTLENS_MAX_OUTPUT_TOKENS=2048
# INCIDENTLENS_MAX_RUN_TOKENS=64000
# INCIDENTLENS_MAX_ROUNDS=2
# INCIDENTLENS_MAX_MODEL_ATTEMPTS=20
# INCIDENTLENS_MAX_TOOL_ATTEMPTS=20
# INCIDENTLENS_DEADLINE_MS=120000
# INCIDENTLENS_REQUEST_TIMEOUT_MS=20000
# INCIDENTLENS_REPORT_RESERVE_MS=25000
# INCIDENTLENS_REPORT_RESERVE_TOKENS=12288
# INCIDENTLENS_REPORT_RESERVE_MODEL_ATTEMPTS=3
# Request starts are spaced; in-flight specialist calls remain concurrent.
# Set spacing from verified project quotas before evaluation (250 ms is not a quota guarantee).
# INCIDENTLENS_MODEL_INTERVAL_MS=250
# INCIDENTLENS_RETRY_DELAY_MS=1000
# Default recursion limit is MAX_ROUNDS * 4 + 3.
# INCIDENTLENS_RECURSION_LIMIT=11
